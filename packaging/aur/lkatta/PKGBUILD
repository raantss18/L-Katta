# Maintainer: RANIRIAMANJAKA Antsa <https://github.com/raantss18>
# Fichier tenu dans https://github.com/raantss18/L-Katta (packaging/aur), mis à jour par tool/aur.sh.
pkgname=lkatta
pkgver=0.3.4
pkgrel=1
pkgdesc="Petit maki (lémurien) assistant de bureau avec IA : discussion, fichiers, mails, agenda, fenêtres"
arch=('x86_64' 'aarch64')
url="https://github.com/raantss18/L-Katta"
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'libxkbcommon')
makedepends=('cargo' 'pkgconf')
optdepends=(
  'wl-clipboard: presse-papiers sous Wayland'
  'xclip: presse-papiers sous X11'
  'libsecret: clés et mots de passe rangés dans le trousseau (secret-tool)'
  'poppler: lecture des PDF (pdftotext)'
  'libpulse: détection du micro pendant une visio (pactl)'
  'xdg-utils: ouvrir liens et fichiers'
  'curl: mails (IMAP, SMTP)'
  'kdotool: fenêtres sous KDE Plasma'
  'ollama: modèle d IA local de secours'
)
provides=('lkatta')
conflicts=('lkatta-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('83174e20cb598ff5669eb2850b26bbb63df9f27a2cb5ea78ac882aead0cb2239')

prepare() {
  cd "L-Katta-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "L-Katta-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "L-Katta-$pkgver"
  install -Dm755 target/release/lkatta "$pkgdir/usr/bin/lkatta"
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 assets/fonts/OFL-*.txt -t "$pkgdir/usr/share/licenses/$pkgname/fonts/"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/lkatta/"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/lkatta/docs/"
  install -Dm644 packaging/linux/lkatta.desktop "$pkgdir/usr/share/applications/lkatta.desktop"
  install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  HOME="$srcdir" target/release/lkatta icone "$pkgdir/usr/share/icons/hicolor/256x256/apps/lkatta.png" >/dev/null
}
